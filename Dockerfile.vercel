# syntax=docker/dockerfile:1

FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /build

COPY pom.xml ./
RUN mvn -q -DskipTests dependency:go-offline

COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app

# Vercel requires the container to accept TCP connections on $PORT very quickly.
# socat opens that public port immediately and forwards traffic to Spring once
# Spring finishes booting on the internal port 8081.
RUN apt-get update \
    && apt-get install -y --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/target/*.jar /app/app.jar
COPY vercel-store-entrypoint.sh /app/vercel-store-entrypoint.sh
RUN chmod +x /app/vercel-store-entrypoint.sh

ENV SPRING_PROFILES_ACTIVE=prod \
    AI_SERVICE_AUTOSTART=false \
    AI_SERVICE_SETUP_VENV=false \
    PRODUCT_IMAGE_STORAGE=database

EXPOSE 80

ENTRYPOINT ["/app/vercel-store-entrypoint.sh"]
