# LSHOE local configuration
# Copy to .env for local/IntelliJ development only.
# Never commit the real .env file.

# PostgreSQL (change these only if your local database differs)
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/lshoe_store
DB_USERNAME=postgres
DB_PASSWORD=postgres

# NVIDIA chatbot (optional)
NVIDIA_API_KEY=

# Email verification / password reset
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=

# Local-only diagnostics (useful while developing)
EMAIL_VERIFICATION_LOG_CODE=true
PASSWORD_RESET_LOG_LINK=true

# Optional bootstrap/demo data
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_DATA=false

# Local ngrok: dev profile already starts ngrok automatically.
# Recommended when verification/reset links must point to the public tunnel.
# Use your ngrok HTTPS domain, for example: https://example.ngrok-free.app
NGROK_PUBLIC_URL=

# Trust forwarded client IPs only from the local ngrok process.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
