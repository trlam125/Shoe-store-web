# SnapDeploy WEB container (repository root, branch main)
# Do not commit real secrets.

# Neon full connection string, including username/password.
DATABASE_URL=

# Required for AI features after the AI container is created.
# Public URL of the separate SnapDeploy AI container.
AI_SERVICE_URL=

# Required for AI features. Use the same long random value in both containers.
AI_INTERNAL_API_KEY=

# Public URL of the WEB container. Required for verification/reset links.
APP_PUBLIC_BASE_URL=

# Optional: NVIDIA-backed website chatbot.
NVIDIA_API_KEY=

# Optional: email verification/password reset.
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
