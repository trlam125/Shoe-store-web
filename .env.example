# ==========================================================
# LSHOE local configuration
# Copy to .env when running from IntelliJ.
# Vercel uses Environment Variables in the dashboard instead
# of this file.
# ==========================================================

# ----- Spring Boot / local runtime -----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
# Optional. Leave blank when IntelliJ's working directory is the project root.
LSHOE_PROJECT_ROOT=

# ----- PostgreSQL (local) -----
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/lshoe_store
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ----- FastAPI AI service (local) -----
# Spring starts the AI service automatically after the web app is ready.
AI_SERVICE_AUTOSTART=true
AI_SERVICE_SETUP_VENV=true
# Leave blank locally. On Vercel Services, set one shared random secret.
AI_INTERNAL_API_KEY=

# ----- Chatbot -----
# Leave blank if the chatbot is not used.
NVIDIA_API_KEY=

# ----- Email verification / password reset -----
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
# Convenient for local development when email is not configured.
EMAIL_VERIFICATION_LOG_CODE=true
PASSWORD_RESET_LOG_LINK=true

# ----- Optional first admin / demo data -----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_DATA=false

# ----- Public URL -----
# Usually blank locally. Set only when using a fixed custom public URL.
APP_PUBLIC_BASE_URL=

# ----- Local tunnel helpers -----
# ngrok is the default local tunnel. Cloudflare remains available as an alternative.
NGROK_TUNNEL_AUTOSTART=true
NGROK_PUBLIC_URL=
CLOUDFLARE_TUNNEL_AUTOSTART=false
# Trust forwarded client IPs only from local tunnel/proxy processes.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ==========================================================
# Vercel dashboard variables (do NOT copy local-only values)
# ==========================================================
# Required:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# AI_INTERNAL_API_KEY=<long-random-secret>
#
# Optional features:
# NVIDIA_API_KEY=...
# MAIL_HOST=smtp.gmail.com
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# BOOTSTRAP_ADMIN_EMAIL=...
# BOOTSTRAP_ADMIN_PASSWORD=...
# APP_PUBLIC_BASE_URL=https://your-domain.example
