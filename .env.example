# Vercel WEB project (repository root: /)
# Do not commit real secrets.

# Neon full connection string. Username/password may be embedded in the URL.
DATABASE_URL=

# Production URL of the separate Vercel AI project.
AI_SERVICE_URL=

# Long random value; must exactly match the AI project.
AI_INTERNAL_API_KEY=

# Optional override for verification/reset links.
# If Vercel System Environment Variables are exposed, the app automatically
# uses VERCEL_PROJECT_PRODUCTION_URL and this can stay empty.
APP_PUBLIC_BASE_URL=

# Optional NVIDIA-backed website chatbot.
NVIDIA_API_KEY=

# Optional email verification/password reset.
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
