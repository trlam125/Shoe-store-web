# syntax=docker/dockerfile:1

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_RELOAD=false \
    AI_HOST=0.0.0.0 \
    AI_INTERNAL_PORT=8001

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 socat \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /tmp/requirements.txt

RUN python -m pip install --no-cache-dir --upgrade pip \
    && grep -Ev '^(torch|torchvision)==' /tmp/requirements.txt > /tmp/requirements-core.txt \
    && python -m pip install --no-cache-dir -r /tmp/requirements-core.txt \
    && python -m pip install --no-cache-dir \
        torch==2.6.0 torchvision==0.21.0 \
        --index-url https://download.pytorch.org/whl/cpu

# Cache ResNet18 weights in the image so image-search requests do not download them at runtime.
RUN python -c "from torchvision.models import ResNet18_Weights, resnet18; resnet18(weights=ResNet18_Weights.DEFAULT)"

COPY . /app
COPY vercel-ai-entrypoint.sh /app/vercel-ai-entrypoint.sh
RUN chmod +x /app/vercel-ai-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/app/vercel-ai-entrypoint.sh"]
