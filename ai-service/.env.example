# SnapDeploy AI container (root directory /ai-service, branch ai-deploy)
# Do not commit real secrets.

# Use the same Neon connection string as the WEB container.
DATABASE_URL=

# Must exactly match the WEB container value.
AI_INTERNAL_API_KEY=

# Public URL of the WEB container, without a trailing slash.
AI_STORE_BASE_URL=
AI_TRUSTED_IMAGE_ORIGINS=
AI_ALLOWED_ORIGINS=
